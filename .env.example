# AI Sidekick for Splunk - Environment Configuration Example
# Copy this file to .env and customize for your setup

# === Basic Configuration (Required) ===
GOOGLE_API_KEY=your_google_api_key_here

# === Multi-Model Provider Settings ===
# Options: auto, google, litellm
MODEL_PROVIDER=auto

# Default model for all agents (if not specified per-agent)
BASE_MODEL=gemini-2.5

# Fallback model
TUTOR_MODEL=gemini-2.0-flash

# === Provider API Keys (Optional - for non-Gemini models) ===
# OpenAI API Key (for GPT models)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude models)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI (for Azure-hosted models)
# AZURE_API_KEY=your_azure_api_key_here
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2023-12-01-preview

# === Agent-Specific Model Preferences ===
# Format: AGENT_NAME_MODEL=model_name
# These override the BASE_MODEL for specific agents

# Use Claude for SPL analysis (excellent code understanding)
# SEARCH_GURU_MODEL=claude-3-sonnet

# Use GPT-4 for complex workflows (best reasoning)
# FLOW_PILOT_MODEL=gpt-4

# Keep Gemini for MCP operations (fast tool execution)
# SPLUNK_MCP_MODEL=gemini-2.0-flash

# Use GPT-4 for orchestration (best multi-agent coordination)
# ORCHESTRATOR_MODEL=gpt-4

# === Model Parameters ===
SPLUNK_AI_TEMPERATURE=0.7
SPLUNK_AI_MAX_TOKENS=4096
SPLUNK_AI_TIMEOUT=30

# === Splunk Connection (Required) ===
SPLUNK_MCP_SERVER_URL=http://localhost:8003/mcp/
SPLUNK_HOST=localhost
SPLUNK_USERNAME=admin
SPLUNK_PASSWORD=your_splunk_password

# === Google Cloud (Optional - for Vertex AI) ===
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-gcp-project
# GOOGLE_CLOUD_LOCATION=us-central1

# === Streaming and Performance (Optional) ===
SPLUNK_AI_ENABLE_STREAMING=true
SPLUNK_AI_MAX_LLM_CALLS=200

# === Multi-Model Usage Examples ===
# 
# Example 1: Use GPT-4 as default for all agents
# MODEL_PROVIDER=litellm
# BASE_MODEL=gpt-4
# OPENAI_API_KEY=your_openai_key
#
# Example 2: Mix different models per agent for optimal performance
# ORCHESTRATOR_MODEL=gpt-4          # Best coordination
# SEARCH_GURU_MODEL=claude-3-sonnet # Best code analysis
# FLOW_PILOT_MODEL=gpt-4            # Best workflows
# SPLUNK_MCP_MODEL=gemini-2.0-flash # Fast tool execution
#
# Example 3: Cost optimization - use cheaper models for simple tasks
# BASE_MODEL=gpt-3.5-turbo          # Cheap default
# SEARCH_GURU_MODEL=gpt-4           # Premium for complex analysis
# FLOW_PILOT_MODEL=claude-3-sonnet  # Best for workflows
#
# To see available models: uv run ai-sidekick --list-models
