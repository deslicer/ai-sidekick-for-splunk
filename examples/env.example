# Multi-Model Configuration Example for AI Sidekick for Splunk
# Copy this to .env and customize for your setup

# =============================================================================
# Google ADK Configuration (Required)
# =============================================================================
GOOGLE_API_KEY="paste-your-actual-key-here"
# If using Gemini via Google AI Studio
GOOGLE_GENAI_USE_VERTEXAI="False"
GOOGLE_CLOUD_PROJECT="your-project-id"
GOOGLE_CLOUD_LOCATION="your-location" #e.g. us-central1

# =============================================================================
# Multi-Model Provider Settings (Optional)
# =============================================================================
# Options: auto (recommended), google, litellm
MODEL_PROVIDER=auto

# LLM Model Configuration
BASE_MODEL=gemini-2.0-flash-exp
TUTOR_MODEL=gemini-2.0-flash-exp

# === Provider API Keys (Optional - for non-Gemini models) ===
# OpenAI API Key (for GPT models: gpt-4, gpt-4-turbo, gpt-3.5-turbo, etc.)
# OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Key (for Claude models: claude-3-opus, claude-3-sonnet, claude-3-haiku, etc.)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Azure OpenAI (for Azure-hosted models)
# AZURE_API_KEY=your_azure_api_key_here
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2023-12-01-preview

# === Agent-Specific Model Preferences (Optional) ===
# Format: AGENT_NAME_MODEL=model_name
# These override the BASE_MODEL for specific agents

# Use Claude for SPL analysis (excellent code understanding)
# SEARCH_GURU_MODEL=claude-3-sonnet

# Use GPT-4 for complex workflows (best reasoning)
# FLOW_PILOT_MODEL=gpt-4

# Keep Gemini for MCP operations (fast tool execution)
# SPLUNK_MCP_MODEL=gemini-2.0-flash

# Use GPT-4 for orchestration (best multi-agent coordination)
# ORCHESTRATOR_MODEL=gpt-4

# =============================================================================
# MCP Server Configuration (Required for Splunk Integration)
# =============================================================================
SPLUNK_MCP_SERVER_URL=http://localhost:8003/mcp/

# Splunk Connection Details (Required for MCP server)
SPLUNK_HOST='add-your-splunk-host'
SPLUNK_PORT='8089'
SPLUNK_SCHEME='https'
SPLUNK_USERNAME='your-splunk-username'
SPLUNK_PASSWORD='your-splunk-password'
SPLUNK_VERIFY_SSL='true'

# =============================================================================
# Model Parameters (Optional)
# =============================================================================
SPLUNK_AI_TEMPERATURE=0.7
SPLUNK_AI_MAX_TOKENS=4096
SPLUNK_AI_TIMEOUT=30

# === Streaming and Performance (Optional) ===
SPLUNK_AI_ENABLE_STREAMING=true
SPLUNK_AI_MAX_LLM_CALLS=200

# =============================================================================
# Logging Configuration (Optional)
# =============================================================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file path relative to project root (default: logs/app.log)
LOG_FILE_PATH=logs/app.log

# =============================================================================
# Multi-Model Usage Examples
# =============================================================================
# 
# Example 1: Use OpenAI GPT-4 as default for all agents
# MODEL_PROVIDER=litellm
# BASE_MODEL=gpt-4
# OPENAI_API_KEY=sk-your-openai-api-key-here
#
# Example 2: Use Anthropic Claude for all agents
# MODEL_PROVIDER=litellm
# BASE_MODEL=claude-3-sonnet
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here
#
# Example 3: Use Azure OpenAI
# MODEL_PROVIDER=litellm
# BASE_MODEL=gpt-4
# AZURE_API_KEY=your-azure-api-key
# AZURE_API_BASE=https://your-resource.openai.azure.com/
# AZURE_API_VERSION=2023-12-01-preview
#
# Example 4: Mix different models per agent for optimal performance
# ORCHESTRATOR_MODEL=gpt-4          # Best coordination
# SEARCH_GURU_MODEL=claude-3-sonnet # Best code analysis
# FLOW_PILOT_MODEL=gpt-4            # Best workflows
# SPLUNK_MCP_MODEL=gemini-2.0-flash # Fast tool execution
#
# Example 5: Cost optimization - use cheaper models for simple tasks
# BASE_MODEL=gpt-3.5-turbo          # Cheap default
# SEARCH_GURU_MODEL=gpt-4           # Premium for complex analysis
# FLOW_PILOT_MODEL=claude-3-sonnet  # Best for workflows
#
# To see available models: uv run ai-sidekick --list-models
